# Gmail SMTP: use a Gmail App Password, never your normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=your-google-app-password
ALERT_FROM=your-address@gmail.com
ALERT_THRESHOLD_PERCENT=20

# Locally downloaded model IDs or paths. Set HF_HOME to choose the model cache.
YOLO_POSE_MODEL=yolov8n-pose.pt
# Optional custom model trained with weapon classes; unset to disable weapon detection.
# WEAPON_MODEL=./models/weapon_detector.pt
ACTION_MODEL=MCG-NJU/videomae-base-finetuned-kinetics
VLM_MODEL=Qwen/Qwen2-VL-2B-Instruct
ACTION_SAMPLE_FPS=5
ACTION_SCORE_THRESHOLD=0.18
PROXIMITY_DISTANCE=0.18
LIMB_SPEED_THRESHOLD=1.5
# HF_HUB_OFFLINE=1
# HF_HOME=./model_cache

# Private, persistent local data directories/settings.
# APP_DATA_DIR=./user_data
# DATABASE_URL=sqlite:///incident_system.db
